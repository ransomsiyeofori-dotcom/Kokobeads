<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="description"
        content="Kokobeads administrator dashboard."
    >

    <link
        rel="stylesheet"
        href="../css/styles.css"
    >

    <link
        rel="stylesheet"
        href="../css/admin.css"
    >

    <title>Kokobeads Admin Dashboard</title>

</head>


<body class="admin-page">


    <!-- =========================================
         HEADER
    ========================================== -->

    <header class="admin-header">

        <div class="admin-header-container">

            <a
                href="../index.html"
                class="admin-logo"
            >
                Kokobeads
            </a>


            <div class="admin-header-right">

                <span class="admin-badge">
                    ADMIN
                </span>

                <a
                    href="./profile.html"
                    class="admin-account-link"
                >
                    My Account
                </a>

                <button
                    type="button"
                    id="adminLogoutButton"
                    class="admin-logout-button"
                >
                    Log Out
                </button>



            </div>

    </header>


    <!-- =========================================
         MAIN
    ========================================== -->

    <main class="admin-main">

        <div class="admin-container">


            <!-- =====================================
                 PAGE HEADING
            ====================================== -->

            <section class="admin-hero">

                <div>

                    <p class="admin-eyebrow">
                        KOKOBEADS ADMINISTRATION
                    </p>

                    <h1>
                        Dashboard
                    </h1>

                    <p>
                        Manage your products and keep your
                        Kokobeads store up to date.
                    </p>

        </div>

            </section>


            <!-- =====================================
                 STATISTICS
            ====================================== -->

            <section
                class="admin-stats"
                aria-label="Store statistics"
            >

                <article class="admin-stat-card">

                    <span class="admin-stat-label">
                        Products
                    </span>

                    <strong
                        id="totalProducts"
                        class="admin-stat-value"
                    >
                        0
                    </strong>

                </article>


                <article class="admin-stat-card">

                    <span class="admin-stat-label">
                        Active Products
                    </span>

                    <strong
                        id="activeProducts"
                        class="admin-stat-value"
                    >
                        0
                    </strong>

                </article>


                <article class="admin-stat-card">

                    <span class="admin-stat-label">
                        Featured
                    </span>

                    <strong
                        id="featuredProducts"
                        class="admin-stat-value"
                    >
                        0
                    </strong>

                </article>


                <article class="admin-stat-card">

                    <span class="admin-stat-label">
                        Low Stock
                    </span>

                    <strong
                        id="lowStockProducts"
                        class="admin-stat-value"
                    >
                        0
                    </strong>

                </article>

            </section>


            <!-- =====================================
                 PRODUCT MANAGEMENT
            ====================================== -->

            <section class="admin-products-section">


                <div class="admin-section-header">

                    <div>

                        <p class="admin-eyebrow">
                            STORE MANAGEMENT
                        </p>

                        <h2>
                            Products
                        </h2>

                </div>


                    <button
                        type="button"
                        id="addProductButton"
                        class="admin-primary-button"
                    >
                        + Add Product
                    </button>

                    </div>

                <!-- Message -->

                <div
                    id="adminMessage"
                    class="admin-message"
                    aria-live="polite"
                ></div>


                <!-- Product filters -->

                <div class="admin-product-filters">

                    <div class="admin-search-box">

                        <span aria-hidden="true">⌕</span>

                        <input
                            type="search"
                            id="adminProductSearch"
                            placeholder="Search products..."
                            autocomplete="off"
                        >

                </div>


                    <select
                        id="adminCategoryFilter"
                        class="admin-filter-select"
                    >
                        <option value="all">All Categories</option>
                    </select>


                    <select
                        id="adminStockFilter"
                        class="admin-filter-select"
                    >
                        <option value="all">All Stock</option>
                        <option value="in-stock">In Stock</option>
                        <option value="low-stock">Low Stock</option>
                        <option value="out-of-stock">Out of Stock</option>
                    </select>


                    <select
                        id="adminFeaturedFilter"
                        class="admin-filter-select"
                    >
                        <option value="all">All Products</option>
                        <option value="featured">Featured</option>
                        <option value="regular">Regular</option>
                    </select>


                    <button
                        type="button"
                        id="clearProductFilters"
                        class="admin-clear-filters"
                    >
                        Clear
                    </button>

                    </div>

                <!-- Product list -->

                <div
                    id="adminProductsList"
                    class="admin-products-list"
                >

                    <div class="admin-loading">

    </main>


    <!-- =========================================
         ADD PRODUCT MODAL
    ========================================== -->

    <div
        id="productModal"
        class="admin-modal"
        hidden
    >

        <div
            class="admin-modal-overlay"
            id="productModalOverlay"
        ></div>


        <div
            class="admin-modal-content"
            role="dialog"
            aria-modal="true"
            aria-labelledby="productModalTitle"
        >

            <div class="admin-modal-header">

                <div>

                    <p class="admin-eyebrow">
                        STORE MANAGEMENT
                    </p>

                    <h2 id="productModalTitle">
                        Add Product
                    </h2>

                </div>


                <button
                    type="button"
                    id="closeProductModal"
                    class="admin-modal-close"
                    aria-label="Close"
                >
                    ×
                </button>

                </div>


            <!-- Product Form -->

            <form
                id="productForm"
                class="admin-product-form"
            >


                <!-- Name -->

                <div class="admin-form-group">

                    <label for="productName">
                        Product Name
                    </label>

                    <input
                        type="text"
                        id="productName"
                        name="name"
                        required
                        maxlength="200"
                        placeholder="e.g. Gold Beaded Bracelet"
                    >

            </div>


                <!-- Description -->

                <div class="admin-form-group">

                    <label for="productDescription">
                        Description
                    </label>

                    <textarea
                        id="productDescription"
                        name="description"
                        required
                        rows="4"
                        placeholder="Describe the product..."
                    ></textarea>

                </div>


                <!-- Price -->

                <div class="admin-form-row">

                    <div class="admin-form-group">

                        <label for="productPrice">
                            Price
                        </label>

                        <input
                            type="number"
                            id="productPrice"
                            name="price"
                            required
                            min="0"
                            step="0.01"
                            placeholder="5000"
                        >

                </div>


                    <div class="admin-form-group">

                        <label for="productOriginalPrice">
                            Original Price
                        </label>

                        <input
                            type="number"
                            id="productOriginalPrice"
                            name="originalPrice"
                            min="0"
                            step="0.01"
                            placeholder="6500"
                        >

                    </div>

                    </div>


                <!-- Category + Stock -->

                <div class="admin-form-row">

                    <div class="admin-form-group">

                        <label for="productCategory">
                            Category
                        </label>

                        <input
                            type="text"
                            id="productCategory"
                            name="category"
                            required
                            placeholder="bracelets"
                        >

                </div>

                    <div class="admin-form-group">

                        <label for="productCollection">
                            Collection
                        </label>

                        <select
                            id="productCollection"
                            name="collection"
                            required
                        >
                            <option value="">Select collection</option>
                        </select>

                    </div>

                    <div class="admin-form-group">

                        <label for="productStock">
                            Stock
                        </label>

                        <input
                            type="number"
                            id="productStock"
                            name="stock"
                            required
                            min="0"
                            step="1"
                            placeholder="20"
                        >

                    </div>

                    </div>


                <!-- Badge -->

                <div class="admin-form-group">

                    <label for="productBadge">
                        Badge
                    </label>

                    <input
                        type="text"
                        id="productBadge"
                        name="badge"
                        placeholder="Bestseller"
                    >

                </div>


                <!-- Image -->

                <div class="admin-form-group">
                    <label for="productImageFile">
                        Product Image
                    </label>

                    <input
                        type="file"
                        id="productImageFile"
                        name="image"
                        accept="image/*"
                    >

                    <div
                        id="productImagePreview"
                        style="display: none; margin-top: 12px;"
                    >
                        <img
                            id="productImagePreviewImg"
                            src=""
                            alt="Product image preview"
                            style="max-width: 220px; max-height: 180px; object-fit: cover; border-radius: 8px;"
                        >
                    </div>

                </div>

                <label class="admin-checkbox">

                    <input
                        type="checkbox"
                        id="productFeatured"
                        name="isFeatured"
                    >

                    <span>
                        Mark as featured product
                    </span>

                </label>


                <!-- Form message -->

                <p
                    id="productFormMessage"
                    class="admin-form-message"
                    aria-live="polite"
                ></p>


                <!-- Actions -->

                <div class="admin-form-actions">

                    <button
                        type="button"
                        id="cancelProductButton"
                        class="admin-secondary-button"
                    >
                        Cancel
                    </button>


                    <button
                        type="submit"
                        id="saveProductButton"
                        class="admin-primary-button"
                    >
                        Save Product
                    </button>

                </div>

            </form>

                </div>

        </div>



        <!-- =========================================
             COLLECTION MANAGEMENT
        ========================================== -->

        <section class="admin-section">

            <div class="admin-section-header">

                <div>
                    <h2>Collection Management</h2>
                    <p>
                        Manage the images used for your Men, Women,
                        Purple Beads and other collections.
                    </p>
                </div>

                <button
                    type="button"
                    id="addCollectionBtn"
                    class="admin-primary-button"
                >
                    + Add Collection
                </button>

            </div>

            <div
                id="adminCollectionsList"
                class="admin-collections-list"
            >
                <div class="admin-loading">
                    Loading collections...
                </div>
            </div>

        </section>


        <!-- =========================================
             COLLECTION MODAL
        ========================================== -->

        <div
            id="collectionModal"
            class="admin-modal"
            style="display: none;"
        >

            <div class="admin-modal-content">

                <div class="admin-modal-header">

                    <h2 id="collectionModalTitle">
                        Add Collection
                    </h2>

                    <button
                        type="button"
                        id="closeCollectionModal"
                        class="admin-modal-close"
                        aria-label="Close"
                    >
                        &times;
                    </button>

                </div>

                <form id="collectionForm">

                    <div class="admin-form-group">
                        <label for="collectionName">
                            Collection Name
                        </label>

                        <input
                            type="text"
                            id="collectionName"
                            name="name"
                            maxlength="200"
                            placeholder="e.g. Men"
                            required
                        >
                    </div>

                    <div class="admin-form-group">
                        <label for="collectionSlug">
                            Collection Slug
                        </label>

                        <input
                            type="text"
                            id="collectionSlug"
                            name="slug"
                            maxlength="200"
                            placeholder="e.g. men"
                            required
                        >

                        <small>
                            Example: men, women, purple-beads
                        </small>
                    </div>

                    <div class="admin-form-group">
                        <label for="collectionDescription">
                            Description
                        </label>

                        <textarea
                            id="collectionDescription"
                            name="description"
                            rows="4"
                            placeholder="Describe this collection..."
                        ></textarea>
                    </div>

                    <div class="admin-form-group">

                        <label for="collectionImageFile">
                            Collection Image
                        </label>

                        <input
                            type="file"
                            id="collectionImageFile"
                            name="image"
                            accept="image/*"
                        >

                        <small>
                            Upload the image that represents this collection.
                        </small>

                        <div
                            id="collectionImagePreview"
                            style="display: none; margin-top: 12px;"
                        >

                            <img
                                id="collectionPreviewImg"
                                src=""
                                alt="Collection image preview"
                                style="
                                    max-width: 220px;
                                    max-height: 180px;
                                    object-fit: cover;
                                    border-radius: 8px;
                                "
                            >

                        </div>

                    </div>

                    <div class="admin-form-group">

                        <label for="collectionSortOrder">
                            Sort Order
                        </label>

                        <input
                            type="number"
                            id="collectionSortOrder"
                            name="sortOrder"
                            min="0"
                            value="0"
                        >

                    </div>

                    <div class="admin-form-group">

                        <label>
                            <input
                                type="checkbox"
                                id="collectionIsActive"
                                name="isActive"
                                checked
                            >

                            Active collection
                        </label>

                    </div>

                    <div class="admin-form-actions">

                        <button
                            type="button"
                            id="deleteCollectionBtn"
                            class="admin-danger-button"
                            style="display: none;"
                        >
                            Delete
                        </button>

                        <button
                            type="button"
                            id="cancelCollectionBtn"
                            class="admin-secondary-button"
                        >
                            Cancel
                        </button>

                        <button
                            type="submit"
                            class="admin-primary-button"
                        >
                            Save Collection
                        </button>

                    </div>

                </form>

            </div>

        </div>

    <!-- =========================================
         JAVASCRIPT
    ========================================== -->

    <script src="../js/admin.js"></script>
    <script src="../js/adminCollections.js"></script>

</body>

</html>
